  "rules": [
    { "year": 2026, "title": "Active Aero statt DRS", "tag": "Neu", "text": "Front- und Heckflügel verstellen sich. Im Straight Mode öffnen beide Klappen in festgelegten Zonen und senken den Luftwiderstand, und das für alle Fahrer, nicht nur innerhalb einer Sekunde zum Vordermann. In Kurven gilt der Corner Mode mit vollem Abtrieb.", "sources": [ { "name": "Formula1.com", "url": "https://www.formula1.com/en/latest/article/f1-2026-regulations-explained-the-key-terms-for-formula-1s-new-for-2026-rules.3T5BU6TC9quGcIpGzoWkY0" } ] },
    { "year": 2026, "title": "Overtake Mode", "tag": "Neu", "text": "Die neue Überholhilfe. Wer weniger als eine Sekunde hinter dem Vordermann liegt, bekommt 0,5 MJ zusätzliche elektrische Energie und damit mehr Leistung als der Verteidiger." },
    { "year": 2026, "title": "Boost", "tag": "Neu", "text": "Per Knopfdruck ruft der Fahrer die volle Leistung der Power Unit ab, zum Angreifen oder Verteidigen. Das leert allerdings die Batterie schneller." },
    { "year": 2026, "title": "Power Unit ~50/50", "tag": "Neu", "text": "Verbrenner und Elektromotor liefern etwa gleich viel Leistung, die MGU-H fällt weg und die MGU-K leistet bis zu 350 kW. In der Praxis liegt die Aufteilung bei rund 53/47 zugunsten des Verbrenners. Energiemanagement ist entscheidend." },
    { "year": 2026, "title": "100 % nachhaltiger Kraftstoff", "tag": "Neu", "text": "Alle Autos fahren mit vollständig nachhaltigem Benzin, synthetisch hergestellt oder aus echten Abfall- und Bio-Rohstoffen." },
    { "year": 2026, "title": "Kleinere, leichtere Autos", "tag": "Neu", "text": "Kürzerer Radstand (max. 3400 mm), schmaleres Auto (1900 mm) und ein geringeres Mindestgewicht von 768 kg. Weniger Abtrieb, dafür agilere Autos." },
    { "year": 2026, "title": "11 Teams, 22 Autos", "tag": "Neu", "text": "Cadillac kommt als elftes Team dazu, Audi übernimmt Sauber. Neue Motorenhersteller sind Audi und Red Bull Ford, Honda arbeitet jetzt mit Aston Martin." },
    { "year": 2026, "title": "Kein Punkt für die schnellste Runde", "tag": "Gilt weiter", "text": "Seit 2025 gibt es keinen Extrapunkt mehr für die schnellste Rennrunde. Punkte erhalten die Top 10 (25-18-15-12-10-8-6-4-2-1), im Sprint die Top 8 (8 bis 1)." },
    { "year": 2027, "title": "Mehr Verbrenner-Anteil", "tag": "Beschlossen", "text": "Die Leistungsaufteilung verschiebt sich auf 58/42 (2027) und 60/40 (2028). Dafür steigt die Verbrenner-Leistung von 400 auf 420 kW (2028: 450 kW), der Benzindurchfluss um 5 % (2028: 13 %).", "sources": [ { "name": "The Race", "url": "https://the-race.com/formula-1/f1-engine-rule-changes-2027-2028/" } ] },
    { "year": 2027, "title": "Aero-Anpassungen", "tag": "Beschlossen", "text": "Änderungen an Unterbodenkante, Planke und Heckflügel sollen den Abtrieb begrenzen. Das schont die Reifen und hilft beim Energiemanagement. Williams-Teamchef Vowles nennt die Eingriffe recht deutlich.", "sources": [ { "name": "The Race", "url": "https://www.the-race.com/formula-1/significant-aero-rule-changes-for-f1-2027-explained/" } ] },
